[Unit]
Description=Qwertycoin node (qwertycoind)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qwcpool
ExecStart=/opt/qwc/bin/qwertycoind --data-dir /opt/qwc/data --non-interactive --rpc-bind-ip 127.0.0.1 --rpc-bind-port 8197 --p2p-bind-port 8196 --no-zmq --log-level 1 --max-log-file-size 0
Restart=on-failure
RestartSec=15
LimitNOFILE=65536
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
