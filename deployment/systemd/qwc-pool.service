[Unit]
Description=Qwertycoin pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=qwc-pool-redis.service qwc-node.service qwc-wallet-rpc.service
Requires=qwc-pool-redis.service
[Service]
Type=simple
User=qwcpool
WorkingDirectory=/opt/qwc-nodejs-pool
ExecStart=/usr/bin/node /opt/qwc-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
