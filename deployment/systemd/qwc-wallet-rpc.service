[Unit]
Description=Qwertycoin pool wallet (wallet-rpc, 127.0.0.1:8198, no password: local use only)
After=qwc-node.service
Requires=qwc-node.service

[Service]
Type=simple
User=qwcpool
ExecStart=/opt/qwc/bin/qwertycoin-wallet-rpc --wallet-file /opt/qwc/wallet/pool --password-file /opt/qwc/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 8198 --disable-rpc-login --daemon-address 127.0.0.1:8197 --trusted-daemon --log-file /opt/qwc/wallet/wallet-rpc.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
